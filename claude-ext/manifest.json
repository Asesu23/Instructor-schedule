{
  "manifest_version": 3,
  "name": "Claude Limit Tracker",
  "version": "1.9",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude Limit Tracker"
  },
  "permissions": [
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js",
        "dialogs.js",
        "ping.js",
        "settings.js"
      ],
      "run_at": "document_start"
    }
  ]
}